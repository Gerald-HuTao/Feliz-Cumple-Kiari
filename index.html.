<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Feliz cumpleaños, Kiara</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Pirata+One&family=Patrick+Hand&display=swap" rel="stylesheet">
<style>
:root{--navy:#17121a;--blue:#a3243a;--sky:#e8c4c9;--cream:#f6efe9;--pink:#f3c4c4;--ink:#2a1d25;
 box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
*,*::before,*::after{box-sizing:inherit}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;font-family:'Patrick Hand','Comic Sans MS',cursive;color:var(--ink);font-size:20px;
  background-color:var(--cream);
 overflow-x:hidden}
h1,h2,.tab{font-family:'Baloo 2','Trebuchet MS',sans-serif}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;gap:6px;justify-content:center;flex-wrap:wrap;padding:10px;background:rgba(251,243,223,.92)}
.tab{border:2px solid var(--navy);background:#fff;color:var(--navy);border-radius:999px;padding:6px 16px;font-size:17px;font-weight:600;cursor:pointer}
.tab[aria-selected=true]{background:var(--navy);color:#fff}
.tab:focus-visible,.btn:focus-visible{outline:3px solid var(--pink);outline-offset:2px}
main{max-width:860px;margin:0 auto;padding:18px 18px 60px}
section{display:none;text-align:center}
section.on{display:block}
h1{font-size:clamp(44px,12vw,84px);line-height:1;margin:.2em 0;color:var(--navy);font-weight:800;-webkit-text-stroke:0;text-shadow:3px 3px 0 #fff,5px 5px 0 var(--sky)}
h2{font-size:clamp(28px,7vw,44px);margin:.3em 0;color:var(--navy);text-shadow:2px 2px 0 #fff}
.btn{font-family:'Baloo 2',sans-serif;font-weight:800;font-size:22px;color:var(--navy);background:#fff;border:3px solid var(--navy);border-radius:999px;padding:8px 34px;cursor:pointer;box-shadow:0 5px 0 var(--navy);transition:transform .1s,box-shadow .1s}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 var(--navy)}
.gift{width:min(300px,70vw);margin:10px auto;display:block;cursor:pointer;transform-origin:50% 90%}
.gift:hover{animation:wob .6s}
@keyframes wob{25%{transform:rotate(-4deg)}75%{transform:rotate(4deg)}}
.card{background:#fff;border:3px solid var(--navy);border-radius:22px;padding:22px 24px;max-width:560px;margin:14px auto;box-shadow:8px 8px 0 var(--sky);text-align:left}
.note{background:var(--pink);border:3px solid var(--navy);border-radius:8px;padding:22px 24px;max-width:560px;margin:14px auto;transform:rotate(-1.2deg);text-align:left;line-height:1.35;box-shadow:6px 6px 0 rgba(29,58,122,.25)}
.note p{margin:.5em 0}
.env{width:min(360px,80vw);margin:0 auto;display:block}
.hint{font-size:18px;opacity:.85}
.cake{width:min(380px,90vw);margin:6px auto;display:block;cursor:pointer}
.flame{transform-origin:50% 100%;animation:fl .5s infinite alternate}
@keyframes fl{to{transform:scale(1.15,.9)}}
.out .flame{display:none}
.cakes{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:4}
.cf{position:absolute;top:-70px;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(115vh) rotate(var(--r,360deg))}}
#hearts{position:fixed;inset:0;pointer-events:none;z-index:1;overflow:hidden}
.h{position:absolute;bottom:-30px;color:var(--blue);opacity:.7;animation:up linear forwards}
@keyframes up{to{transform:translateY(-110vh) rotate(25deg);opacity:0}}
main,nav{position:relative;z-index:2}
@media (prefers-reduced-motion:reduce){.h,.flame,.gift:hover{animation:none}}
body{background-image:linear-gradient(rgba(255,255,255,.28),rgba(255,255,255,.28)),url(data:image/jpeg;base64,);background-size:cover;background-position:right center;background-attachment:fixed}
h1,h2{font-family:'Pirata One','Baloo 2',serif;font-weight:400;letter-spacing:.02em}
h1{text-shadow:3px 3px 0 #fff,6px 6px 0 var(--blue)}
.photo{display:block;width:min(420px,86vw);margin:10px auto 16px;border:5px solid #fff;outline:3px solid var(--navy);border-radius:4px;box-shadow:8px 8px 0 var(--sky);transform:rotate(-1.5deg)}
.cakeimg{display:block;width:min(360px,80vw);margin:6px auto;cursor:pointer;filter:drop-shadow(0 10px 14px rgba(0,0,0,.35));transition:transform .2s}
.cakeimg:active{transform:scale(.97)}
.misa{display:none;position:fixed;z-index:3;pointer-events:none;width:clamp(100px,17vw,240px);height:auto;
 filter:drop-shadow(2px 0 0 #fff) drop-shadow(-2px 0 0 #fff) drop-shadow(0 2px 0 #fff) drop-shadow(0 -2px 0 #fff) drop-shadow(3px 5px 0 rgba(23,18,26,.3))}
.misa.show{display:block;animation:pop .5s cubic-bezier(.3,1.6,.5,1) both,bob 4s .5s ease-in-out infinite alternate}
.misa.l{left:.5vw;top:22vh}.misa.r{right:.5vw;bottom:4vh}
@keyframes pop{from{transform:scale(.3) rotate(-12deg);opacity:0}}
@keyframes bob{to{transform:translateY(-8px) rotate(2deg)}}
@media (max-width:700px){.misa{width:104px}.misa.l{top:auto;bottom:0;left:0}.misa.r{bottom:0;right:0}main{padding-bottom:130px}}
@media (prefers-reduced-motion:reduce){.misa.show{animation:none}}
.polas{display:flex;flex-wrap:wrap;gap:26px;justify-content:center;margin:18px 0 26px}
.pola{position:relative;margin:0;background:#fff;padding:10px 10px 8px;border:3px solid var(--navy);box-shadow:6px 6px 0 var(--sky);width:min(290px,78vw)}
.pola img{display:block;width:100%;height:auto}
.pola figcaption{font-size:24px;padding-top:6px;color:var(--navy)}
.pola::before{content:"";position:absolute;top:-14px;left:50%;width:84px;height:26px;margin-left:-42px;background:rgba(243,196,196,.85);transform:rotate(-3deg)}
.pola.a{transform:rotate(-3deg)}.pola.b{transform:rotate(2.5deg)}
</style>
</head>
<body>
<div id="hearts" aria-hidden="true"></div>
<div class="cakes" id="cakes" aria-hidden="true"></div>
<img class="misa l show" data-tab="home" src="data:image/webp;base64," alt="">
<img class="misa r show" data-tab="home" src="data:image/webp;base64," alt="">
<img class="misa l" data-tab="fot" src="data:image/webp;base64," alt="">
<img class="misa r" data-tab="fot" src="data:image/webp;base64," alt="">
<img class="misa l" data-tab="msg" src="data:image/webp;base64," alt="">
<img class="misa r" data-tab="msg" src="data:image/webp;base64," alt="">
<img class="misa l" data-tab="flo" src="data:image/webp;base64," alt="">
<img class="misa r" data-tab="flo" src="data:image/webp;base64," alt="">
<img class="misa l" data-tab="son" src="data:image/webp;base64," alt="">
<img class="misa r" data-tab="son" src="data:image/webp;base64," alt="">
<img class="misa l" data-tab="cak" src="data:image/webp;base64," alt="">
<img class="misa r" data-tab="cak" src="data:image/webp;base64," alt="">


<nav role="tablist" aria-label="Secciones">
 <button class="tab" role="tab" aria-selected="true" data-t="home">Cumpleaños</button>
 <button class="tab" role="tab" aria-selected="false" data-t="fot">Kiara</button>
 <button class="tab" role="tab" aria-selected="false" data-t="msg">Mensaje</button>
 <button class="tab" role="tab" aria-selected="false" data-t="flo">Flores</button>
 <button class="tab" role="tab" aria-selected="false" data-t="son">Canción</button>
 <button class="tab" role="tab" aria-selected="false" data-t="cak">Pastel</button>
</nav>
<main>
<section id="home" class="on">
 <h1>¡Feliz cumple,<br>Kiara!</h1>
 <svg class="gift" id="gift" viewBox="0 0 300 300" role="button" tabindex="0" aria-label="Abrir regalo">
  <ellipse cx="150" cy="282" rx="105" ry="12" fill="rgba(29,58,122,.18)"/>
  <ellipse cx="62" cy="70" rx="24" ry="30" fill="#7a1423" stroke="#17121a" stroke-width="3"/><path d="M62 100 q-6 40 14 70" stroke="#17121a" stroke-width="2" fill="none"/>
  <ellipse cx="244" cy="60" rx="22" ry="28" fill="#f3e9e4" stroke="#17121a" stroke-width="3"/><path d="M244 88 q8 40 -16 80" stroke="#17121a" stroke-width="2" fill="none"/>
  <rect x="68" y="130" width="164" height="140" rx="6" fill="#b3253b" stroke="#17121a" stroke-width="4"/>
  <rect x="136" y="130" width="28" height="140" fill="#17121a"/>
  <rect id="lid" x="58" y="104" width="184" height="36" rx="6" fill="#8e1b2b" stroke="#17121a" stroke-width="4"/>
  <rect x="136" y="104" width="28" height="36" fill="#17121a"/>
  <path d="M150 104 C110 50 80 80 120 104 Z M150 104 C190 50 220 80 180 104 Z" fill="#7a1423" stroke="#17121a" stroke-width="4"/>
  <circle cx="150" cy="104" r="12" fill="#17121a"/>
 </svg>
 <p class="hint">Tengo algo muy especial para ti</p>
 <button class="btn" id="open">Ábrelo</button>
</section>

<section id="fot">
 <h2>La cumpleañera</h2>
 <div class="polas">
  <figure class="pola a"><img src="data:image/jpeg;base64," alt="Kiara con lentes y chaleco gris"><figcaption>Kiara</figcaption></figure>
  <figure class="pola b"><img src="data:image/jpeg;base64," alt="Kiara con lentes y ropa negra"><figcaption>Hoy brillas tú ✨</figcaption></figure>
 </div>
 <button class="btn" data-go="msg">Siguiente</button>
</section>

<section id="msg">
 <h2>Para ti</h2>
 <div class="note">
  <p><b>Kiara,</b></p>
  <p>Hoy es tu día y quise hacerte algo con mucho cariño, porque mereces que te celebren como se debe.</p>
  <p>Ojalá este nuevo año llegue lleno de cosas bonitas, de gente que te quiera de verdad y de esas risas que hacen doler la barriga.</p>
  <p>Gracias por todo lo lindo que compartimos. Te deseo lo mejor del mundo, hoy y siempre, con todo mi cariño.</p>
  <p>¡Feliz cumpleaños, Kiara! 🖤</p>
 </div>
 <p class="hint">Todavía hay más para ti</p>
 <button class="btn" data-go="flo">Siguiente</button>
</section>

<section id="flo">
 <h2>Flores para ti</h2>
 <img class="photo" src="data:image/jpeg;base64," alt="Ramo de rosas rojas con Death Note para Kiara">
 <div class="card"><b>Que tu vida florezca</b> como estas rosas: con mucho amor, mucha paz y una alegría que nunca se te acabe.</div>
 <button class="btn" data-go="son">Siguiente</button>
</section>

<section id="son">
 <h2>Una canción para ti</h2>
 <div class="card" style="text-align:center">
  <a href="https://youtu.be/c3aN6Tv4WLA" target="_blank" rel="noopener" aria-label="Abrir Alma dinamita en YouTube" style="display:block;max-width:320px;margin:0 auto;border:3px solid var(--navy);border-radius:14px;overflow:hidden;box-shadow:6px 6px 0 var(--sky)">
   <img src="data:image/jpeg;base64," alt="Portada de Tres Puntos Suspensivos" style="display:block;width:100%;height:auto">
  </a>
  <p style="margin:.8em 0 .2em"><b>Alma dinamita</b></p>
  <p class="hint" style="margin:.2em 0 .8em">Toca la portada para escucharla en YouTube</p>
  <a class="btn" href="https://youtu.be/c3aN6Tv4WLA" target="_blank" rel="noopener" style="display:inline-block;text-decoration:none;font-size:18px;padding:6px 24px">Abrir en YouTube</a>
 </div>
 <button class="btn" data-go="cak">Siguiente</button>
</section>

<section id="cak">
 <h2>Pide un deseo</h2>
 <img class="cakeimg" id="cake" role="button" tabindex="0" src="data:image/webp;base64," alt="Pastel de Death Note con velas">
 <p class="hint" id="cakeHint">Toca el pastel y pide un deseo</p>
 <div class="card" id="final" hidden style="text-align:center"><b>Que cada deseo que pediste se haga realidad, Kiara.</b><br>Eres especial y mereces un año precioso. ¡Feliz cumpleaños! 🎂🖤</div>
</section>
</main>
<script>
(function(){
 var tabs=document.querySelectorAll('.tab'),secs=document.querySelectorAll('section');
 function show(id){
  secs.forEach(function(s){s.classList.toggle('on',s.id===id)});
  tabs.forEach(function(t){t.setAttribute('aria-selected',t.dataset.t===id)});
  window.scrollTo(0,0);
  document.querySelectorAll('.misa').forEach(function(m){m.classList.toggle('show',m.dataset.tab===id)});
  if(id!=='home')burst(10);
 }
 tabs.forEach(function(t){t.addEventListener('click',function(){show(t.dataset.t)})});
 document.querySelectorAll('[data-go]').forEach(function(b){b.addEventListener('click',function(){show(b.dataset.go)})});
 var layer=document.getElementById('hearts');
 function heart(){
  var h=document.createElement('span');h.className='h';h.textContent=Math.random()>.3?'♥':'✦';
  h.style.left=Math.random()*100+'vw';h.style.fontSize=(14+Math.random()*22)+'px';
  h.style.animationDuration=(5+Math.random()*5)+'s';layer.appendChild(h);
  setTimeout(function(){h.remove()},10500);
 }
 function burst(n){for(var i=0;i<n;i++)setTimeout(heart,i*90)}
 if(!matchMedia('(prefers-reduced-motion:reduce)').matches){setInterval(heart,1400)}
 function rain(n){
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var box=document.getElementById('cakes'),set=['🎂','🎂','🎂','🍰','🧁'];
  for(var i=0;i<n;i++)(function(i){setTimeout(function(){
   var c=document.createElement('span');c.className='cf';c.textContent=set[Math.floor(Math.random()*set.length)];
   c.style.left=Math.random()*94+'vw';c.style.fontSize=(28+Math.random()*34)+'px';
   c.style.setProperty('--r',(Math.random()>.5?1:-1)*(180+Math.random()*360)+'deg');
   c.style.animationDuration=(2.6+Math.random()*2.2)+'s';box.appendChild(c);
   setTimeout(function(){c.remove()},5000);
  },i*70)})(i);
 }
 function openGift(){burst(26);rain(50);setTimeout(function(){show('fot')},500)}
 document.getElementById('open').addEventListener('click',openGift);
 var g=document.getElementById('gift');
 g.addEventListener('click',openGift);
 g.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();openGift()}});
 var cake=document.getElementById('cake');
 function blow(){
  cake.classList.add('out');
  document.getElementById('cakeHint').hidden=true;
  document.getElementById('final').hidden=false;
  burst(40);rain(40);
 }
 cake.addEventListener('click',blow);
 cake.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();blow()}});
})();
</script>
</body>
</html>
